{
    // Managed by uv: pyproject.toml lists the packages, uv.lock pins them, and
    // `uv sync` builds .venv. The interpreter is .venv's; packages go through uv.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python-envs.alwaysUseUv": true,
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:uv"
        }
    ]
}
