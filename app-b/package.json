{
  "name": "bulk-quote",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Bulk electricity quote calculator (version B of HUMQuote) and the shared calculation core used by version A.",
  "scripts": {
    "data": "node scripts/dev-data.mjs",
    "dev": "npm run data && vite",
    "build": "tsc --noEmit && vite build && vite build --config vite.core.config.ts",
    "build:core": "vite build --config vite.core.config.ts",
    "site": "node scripts/assemble-site.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "1.64.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwind-merge": "3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
